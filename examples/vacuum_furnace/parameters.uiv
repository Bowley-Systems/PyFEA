[version]
format: 0.1.0

[notes]
# This configuration file describes a vacuum-insulated tube furnace based on the
# GSL1100X8S axial measurements with custom radial measurements and materials. 
#
# The heater is purely resistive being run with a constant current source until
# the voltage starts to sag at the supply limit

[source]
supply_limit:       24 (V)
constant_current:   5 (A)

[sample_area]
material:           "vacuum"

axial_length:       1000 m(m)
radial_length:      50 m(m)

[tube]
material:           "silica"

radial_length:      1000 m(m)
radial_thickness:   5 m(m)

[heater]
material:           "nichrome_70_30"

radial_length:      600 m(m)
radial_thickness:   50 m(m)

wire_diameter:      1.25 m(m)
fill_factor:        0.8

[insulation]
material:           "alumina"

radial_length:      600 m(m)
radial_thickness:   100 m(m)