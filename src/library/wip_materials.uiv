[version]
format: 0.1.0
unit_frame: si_metric.ut
note: "Standard library for PyFea useful for standard multi-physics problems"

[standards]
temperature:    298.15 (K)
pressure:       101.32 k(Pa)
note: "Standard lab conditions - unless overwritten by material"

[air.meta]
type: "gas"
mixture: "Homogeneous"
humidity: "Assume Dry (Percentage Unknown)"

[air.physical]
density:                1.184 (kg/m^3)
absolute_viscosity:     18.6 u(Pa*s)

[air.chemical]
molar_mass:             28.96 m(kg/mol)

[air.electrical]
relative_permittivity: [1.0, 1.0]
dielectric_breakdown: 3.1 M(V/m)

temperature_conductivity: [
  [200.0, 5.0],
  [700.0, 5.0],
  [1200.0, 5.0],
  [1700.0, 5.0],
] (K), f(s_m)

[air.magnetic]
relative_permeability: [1.0, 1.0]

[air.thermal]
specific_heat: 1.006 k(c)
temperature_conductivity: [
  [200.0, 18.1],
  [250.0, 22.3],
  [300.0, 26.1],
  [350.0, 29.7],
  [400.0, 33.1],
  [450.0, 36.3],
  [500.0, 39.5],
  [550.0, 42.6],
  [600.0, 45.6],
  [700.0, 51.3],
  [800.0, 56.9],
  [900.0, 62.5],
  [1000.0, 67.2],
  [1200.0, 75.9],
  [1400.0, 83.5],
  [1600.0, 90.4],
  [1800.0, 97.0],
  [2000.0, 103.2]
] (K), m(k)




[copper.meta]
type: "material"
purity: "pure"
note: "Annealed copper"

[copper.physical]
density:            8930 (kg/m^3)

poisson_ratio:      0.343
shear_modulus:      46.0 G(Pa)
yield_strength:     33.3 M(Pa)
tensile_strength:   210.0 M(Pa)
youngs_modulus:     110.0 G(Pa)
bulk_modulus:       140.0 G(Pa)

[copper.chemical]
molar_mass:         63.55 m(kg/mol)

[copper.electrical]
relative_permittivity: [1, 1] 
temperature_conductivity: [
  [273.0, 63],
  [473.0, 34],
  [673.0, 23],
  [873.0, 17],
  [1073.0, 14],
  [1273.0, 11]
] (K), M(s_m)

[copper.thermal]
specific_heat: 385 (c)
temperature_conductivity: [
  [273.0, 401.0],
  [473.0, 389.0],
  [673.0, 378.0],
  [873.0, 366.0],
  [1073.0, 352.0],
  [1273.0, 336.0]
] (K), (k)

